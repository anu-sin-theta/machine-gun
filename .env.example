# Kavach402 environment. Copy to .env and fill in. Never commit .env.
# Validated at startup by src/config/env.ts (piece 2): a missing or bad value fails fast.

# --- App ---
APP_BASE_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Hedera (testnet) ---
HEDERA_NETWORK=testnet
# Agent's paying account (get one at portal.hedera.com). Needs testnet HBAR.
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
# Account that receives merchant / checker payments (x402 payTo).
HEDERA_PAYEE_ACCOUNT_ID=
# Created once by a setup script (piece 4).
HEDERA_HCS_AUDIT_TOPIC_ID=
HEDERA_HCS_REPUTATION_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# --- x402 ---
# Blocky402 testnet. Alternatives: https://testnet.facilitator.launa.dev, https://x402.org/facilitator
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- 0G Private Computer ---
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_API_KEY=
# Model ids from https://pc.0g.ai/models (confirm one supports private mode; see HANDOFF open question 3)
ZG_MODEL_TEXT=
ZG_MODEL_VISION=
# private | verified
ZG_TRUST_MODE=private

# --- World ID Agent Pass (OIDC) ---
WORLD_ISSUER=https://auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# Must match the redirect URI registered at auth.world.org/portal
WORLD_REDIRECT_URI=http://localhost:3000/api/worldid/callback

# --- Policy (integer base units; 1 HBAR = 100000000 tinybars) ---
POLICY_HBAR_AUTO_CAP=200000000
POLICY_HBAR_HARD_CAP=5000000000
POLICY_HBAR_DAILY_AUTO_BUDGET=500000000
# How long a World step-up attempt stays valid
APPROVAL_TTL_SECONDS=600
