# Kavach402 environment. Copy to .env and fill in. Never commit .env.
# Validated at startup by src/config/env.ts (piece 3): a missing or bad value fails fast.

# --- App ---
# AGENT_MODE=demo swaps 0G, merchant settlement and the on-chain logs for labelled local stand-ins
# so the whole product runs with no keys and no money. Combine with WORLD_MODE=simulated for a
# fully offline demo. Leave unset (live) for the real integrations.
# AGENT_MODE=demo
APP_BASE_URL=http://localhost:3000
# Extra origins the agent may fetch merchant payment requests from (comma-separated). The app's own origin is always allowed.
# MERCHANT_ORIGINS=https://merchant.example

# Protects POST /api/checks (min 16 chars). Unset means the endpoint is open: only do that locally.
# API_TOKEN=

# --- Database (Neon Postgres) ---
DATABASE_URL=

# --- Hedera (testnet) ---
HEDERA_NETWORK=testnet
# Agent's paying account (get one at portal.hedera.com). Needs testnet HBAR.
HEDERA_AGENT_ACCOUNT_ID=
HEDERA_AGENT_PRIVATE_KEY=
# Account that receives merchant / checker payments (x402 payTo).
HEDERA_PAYEE_ACCOUNT_ID=
# Created once by `pnpm setup:hedera`.
HEDERA_HCS_AUDIT_TOPIC_ID=
HEDERA_HCS_REPUTATION_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# --- x402 ---
# Blocky402 testnet. Alternatives: https://testnet.facilitator.launa.dev, https://x402.org/facilitator
X402_FACILITATOR_URL=https://api.testnet.blocky402.com

# --- 0G Private Computer ---
ZG_BASE_URL=https://router-api.0g.ai/v1
ZG_API_KEY=
# Model ids from https://pc.0g.ai/models. Private-labelled models are text-only (e.g. glm-5.3); see HANDOFF piece 4 notes.
ZG_MODEL_TEXT=
ZG_MODEL_VISION=
# private | verified
ZG_TRUST_MODE=private

# --- World ID Agent Pass (OIDC) ---
# WORLD_MODE=simulated runs the same OIDC flow against a simulator built into this app, with a
# consent page where YOU choose the result. Demo and local development only: anyone who can reach
# the app can approve payments. Leave unset (real) and fill WORLD_CLIENT_ID/SECRET for World.
# WORLD_MODE=simulated
# WORLD_SIM_SECRET=
# WORLD_SIM_KEY=
WORLD_ISSUER=https://auth.world.org
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# Defaults to <APP_BASE_URL>/api/worldid/callback. Must match the redirect URI registered at auth.world.org/portal
# WORLD_REDIRECT_URI=http://localhost:3000/api/worldid/callback
# Accepted acr values per tier (comma-separated URIs). World advertises only orb and orb-face.
# WORLD_ACR_HUMAN=https://world.org/oidc/acr/orb,https://world.org/oidc/acr/orb-face
# WORLD_ACR_STRONG=https://world.org/oidc/acr/orb-face

# --- Policy (integer base units; 1 HBAR = 100000000 tinybars) ---
POLICY_HBAR_AUTO_CAP=200000000
POLICY_HBAR_HARD_CAP=5000000000
POLICY_HBAR_DAILY_AUTO_BUDGET=500000000
# How long a World step-up attempt stays valid
APPROVAL_TTL_SECONDS=600

# --- Example agents (examples/gemini-agents, testing only; not read by the app) ---
# Key from https://aistudio.google.com/apikey. Without it, run the agents with --offline.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
