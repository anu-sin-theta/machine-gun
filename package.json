{
  "name": "kavach402",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome check --write",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.mts",
    "check": "pnpm lint && pnpm lint:rust && pnpm typecheck && pnpm test:rust && pnpm build:wasm:check && pnpm test:coverage",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:wasm:check": "node scripts/build-wasm.mjs --check",
    "lint:rust": "cd rust && cargo fmt --all --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test:e2e": "pnpm build && playwright test",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "gen:sim-key": "node scripts/gen-sim-key.mjs",
    "setup:hedera": "node --env-file=.env scripts/create-topics.mjs",
    "test:rust": "cd rust && cargo test --workspace --locked",
    "agents:gemini": "node examples/gemini-agents/server.mjs",
    "walkthrough": "node scripts/walkthrough.mjs"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.90.1",
    "@neondatabase/serverless": "1.2.0",
    "@x402/core": "2.30.0",
    "@x402/fetch": "2.30.0",
    "@x402/hedera": "2.30.0",
    "@x402/next": "2.30.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "next": "16.4.5",
    "openai": "7.52.0",
    "openid-client": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@tailwindcss/turbopack": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@11.24.0"
}
